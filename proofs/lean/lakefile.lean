import Lake
open Lake DSL

-- Same revision as the `aeneas`/`charon` binaries pinned in the repository's flake.nix.
require aeneas from git
  "https://github.com/AeneasVerif/aeneas" @ "8f4466db9f0d59267b8e76b54473a21a005cf7be" / "backends/lean"

-- The hand-written specification (`proofs/spec`, library `SudoersSpec`).
require «sudoers-spec» from "../spec"

package «sudo_rs_proofs» where
  -- Generated code mirrors Rust paths (e.g. `sudo_rs.sudoers.…`).
  leanOptions := #[⟨`weak.linter.dupNamespace, false⟩]

/-- Code generated by `proofs/extract.sh` (Charon + Aeneas), plus the hand-written
models of external definitions (`SudoRs/TypesExternal.lean`, `SudoRs/FunsExternal.lean`). -/
@[default_target] lean_lib SudoRs

/-- Specifications and proofs about the generated code. -/
@[default_target] lean_lib SudoRsProofs
